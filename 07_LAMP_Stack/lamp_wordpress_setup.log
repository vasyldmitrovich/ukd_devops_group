<<EOF
<VirtualHost *:80>
    ServerName wp.prod.local
    DocumentRoot /var/www/wordpress

    <Directory /var/www/wordpress>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog \${APACHE_LOG_DIR}/wp_prod_error.log
    CustomLog \${APACHE_LOG_DIR}/wp_prod_access.log combined
</VirtualHost>
